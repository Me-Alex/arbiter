{
  "name": "arbiter",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first sports arbitrage scanner for Romanian bookmakers",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node src/server.mjs",
    "desktop": "electron .",
    "desktop:dev": "cross-env ARBITER_DEV=1 electron .",
    "tinyfish:diagnose": "node scripts/diagnose-tinyfish-books.mjs",
    "tinyfish:discover": "node scripts/discover-smoke.mjs",
    "tinyfish:smoke": "node scripts/tinyfish-smoke.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "live-check": "node scripts/live-check.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "cleanup:staging": "node scripts/cleanup.mjs --staging-only",
    "cleanup:logs": "node scripts/cleanup.mjs --logs-only",
    "cleanup:backups": "node scripts/cleanup.mjs --backups-only",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint src electron public/js scripts test",
    "ci:preflight": "node scripts/ci-preflight.mjs",
    "ci:preflight:clean": "node scripts/ci-preflight.mjs --clean",
    "measure": "node scripts/measure.mjs",
    "measure:sync": "node scripts/sync-measurements.mjs",
    "measure:sync:write": "node scripts/sync-measurements.mjs --write",
    "smoke:trend": "node scripts/smoke-trend.mjs",
    "market:coverage": "node scripts/market-coverage.mjs",
    "build:snapshot": "node scripts/build-snapshot.mjs",
    "new-book": "node scripts/add-book.mjs",
    "rea:doctor": "node scripts/rea-discover.mjs doctor",
    "rea:discover": "node scripts/rea-discover.mjs discover",
    "rea:har": "node scripts/rea-discover.mjs har",
    "rea:bundle": "node scripts/rea-discover.mjs bundle",
    "dev:frontend": "vite --config vite.config.ts",
    "build:frontend": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "preview:frontend": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.19",
    "lucide-react": "^1.56.0",
    "playwright": "^1.47.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
